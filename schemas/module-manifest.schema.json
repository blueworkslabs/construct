{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construct.local/schemas/module-manifest.schema.json",
  "title": "Construct Module Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "constructApi",
    "runtime",
    "entry",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"
    },
    "constructApi": {
      "type": "object",
      "required": [
        "min",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "declarative-ui",
            "webview-js",
            "trusted-native"
          ]
        }
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "optional": {
            "type": "boolean",
            "default": false
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 260
            },
            "description": "Exact public HTTPS origins; required only for net.http in API0.9 or later. Native and publisher validators enforce origin syntax and capability/version binding."
          }
        }
      },
      "allOf": [
        {
          "if": {
            "contains": {
              "properties": {
                "id": {
                  "const": "image.markers"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "then": {
            "contains": {
              "properties": {
                "id": {
                  "const": "image.read"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        {
          "if": {
            "contains": {
              "properties": {
                "id": {
                  "const": "photos.library"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "then": {
            "contains": {
              "properties": {
                "id": {
                  "const": "image.read"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        {
          "if": {
            "contains": {
              "properties": {
                "id": {
                  "const": "image.analyze"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "then": {
            "contains": {
              "properties": {
                "id": {
                  "const": "image.read"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        }
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "homepage": {
      "type": "string"
    },
    "themeColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Optional native window background colour; requires host API0.6.0."
    }
  }
}
